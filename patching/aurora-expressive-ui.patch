     )
+    val gmsLabel = stringResource(R.string.details_gsf_dependent)
+    val requiresGms = app.requiresGMS()
+
+    return remember(
+        app.size,
+        app.downloadString,
+        app.labeledRating,
+        app.isFree,
+        app.containsAds,
+        requiresGms,
+        priceLabel,
+        adsLabel,
+        gmsLabel
